# Optional: override local JSON database file used by Next.js API routes.
# Default: frontend/.career-rocket-db.json
CAREER_ROCKET_DB_FILE=

# Optional: staging API base for counselling lookup proxy routes.
STAGING_API_URL=https://api.careerrocketstaging.online

# Optional: set only if frontend should call an API host outside this Next.js app.
NEXT_PUBLIC_API_URL=
